{
  "name": "3d-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "3D animated videos: Three.js (React Three Fiber) + Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render src/index.ts Main out/video.mp4",
    "still": "remotion still src/index.ts Main out/still.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "^4.0.543",
    "@remotion/cli": "^4.0.543",
    "@remotion/install-whisper-cpp": "^4.0.543",
    "@remotion/media-utils": "^4.0.543",
    "@remotion/three": "^4.0.543",
    "@remotion/transitions": "^4.0.543",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
